# Copiá este archivo a .env.local y completá con los datos de TU proyecto Supabase
# (Supabase → Project Settings → API). No subas nunca el .env.local.
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=TU_ANON_KEY

# Solo servidor (feed iCal). Nunca con prefijo NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=TU_SERVICE_ROLE_KEY

# Opcional: clave para /api/ical?token=...
ICAL_TOKEN=una-clave-larga-que-inventes
